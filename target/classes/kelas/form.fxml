<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Pencatatan Produk" />
            <Button onAction="#bukaDaftar" text="Lihat Daftar" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label styleClass="subtitle" text="Catat Produk Baru" />
                        <Label text="Nama Produk" />
                        <TextField fx:id="produkField" promptText="Contoh: Roti Kukuk" />
                        <Label text="Jenis Produk" />
                        <ComboBox fx:id="jenisBox" maxWidth="Infinity" />
                        <Label text="Harga" />
                        <TextField fx:id="hargaField" promptText="Contoh: 5000" />
                        <Button maxWidth="Infinity" onAction="#simpan" styleClass="button-primary" text="Simpan dan Lihat Produk" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
